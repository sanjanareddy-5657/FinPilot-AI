# Required for production. Use a long, random value.
JWT_SECRET=replace-with-a-long-random-secret

# Development defaults are shown here. Update these when deploying.
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# Required in production to deliver password-reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM=FinPilot AI <mailer@example.com>

# Optional: Enables Gemini AI-powered financial analysis (Phase 1).
# If omitted, the app falls back to the built-in rule-based analyzer.
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=
